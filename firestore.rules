rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.members[request.auth.uid] == true;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members[request.auth.uid] == true;
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    match /triggers/{triggerId} {
      allow read: if signedIn() && (
        resource.data.owner == request.auth.uid
        || (
          resource.data.visibility == 'partner'
          && resource.data.confidential == false
          && resource.data.roomId is string
          && isRoomMember(resource.data.roomId)
        )
      );
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && (
          request.resource.data.visibility == 'private'
          || (
            request.resource.data.visibility == 'partner'
            && request.resource.data.roomId is string
            && isRoomMember(request.resource.data.roomId)
          )
        );
      allow update, delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}

